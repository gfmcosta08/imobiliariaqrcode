# Exemplo de variaveis para Vercel Preview / Homologacao.
# Nao coloque valores reais neste arquivo. Configure os valores de verdade no painel da Vercel.

NEXT_PUBLIC_SUPABASE_URL=https://projeto-staging.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon_key_staging
SUPABASE_SERVICE_ROLE_KEY=service_role_staging

NEXT_PUBLIC_APP_URL=https://preview-ou-develop.vercel.app
CRON_SECRET=cron_secret_staging

# Stripe deve usar modo teste em Preview.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
STRIPE_PRICE_SOLO=price_test_solo
STRIPE_PRICE_PRO=price_test_pro
STRIPE_PRICE_PREMIUM=price_test_premium

# WhatsApp/Uazapi de homologacao.
# Preencher somente quando houver numero/instancia exclusiva de teste.
UAZAPI_BASE_URL=https://api-de-teste.example.com
UAZAPI_TOKEN=token_staging
UAZAPI_INSTANCE_ID=instancia_staging
