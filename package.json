{
  "name": "imobiliariaqrcode",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter web run typecheck",
    "architecture:check": "pnpm --filter web run architecture:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter web run test && pnpm --filter @imobiliariaqrcode/property-importer run test",
    "test:bot-guardrails": "pnpm --filter web exec vitest run src/guardrails"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  },
  "pnpm": {
    "overrides": {
      "undici": "^7.28.0",
      "ws": "^8.21.0"
    }
  }
}
