# Copie para apps/web/.env.local e preencha.
# Local: apos `pnpm exec supabase start`, use `pnpm exec supabase status` para URL e chaves.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Nunca exponha a service_role no frontend. Use apenas em rotas/servidor seguro.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publica do app usada nos redirects do Stripe e mensagens WhatsApp.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron/rotas internas.
# CRON_SECRET=...

# Stripe
# Obtenha as chaves em https://dashboard.stripe.com/apikeys
# Use sk_test com Price IDs de teste e sk_live com Price IDs de producao.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs dos precos criados no Stripe Dashboard.
# Conta vinculada nesta implementacao: Area restrita de imoveisqr (acct_1TTpQqDF917sGAMh)
STRIPE_PRICE_SOLO=price_1TTrnlDF917sGAMhDmPD7jWF
STRIPE_PRICE_PRO=price_1TTqJADF917sGAMhCbMl43h2
STRIPE_PRICE_PREMIUM=price_1TTqM1DF917sGAMhiEAuF9m1

# Endpoint do webhook a registrar no Stripe Dashboard:
#   https://seu-dominio.com.br/api/webhooks/stripe
# Eventos necessarios:
#   checkout.session.completed
#   invoice.payment_succeeded
#   invoice.payment_failed
#   customer.subscription.deleted
#   customer.subscription.updated
